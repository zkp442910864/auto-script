{
  "name": "shipping-automation-console",
  "private": true,
  "version": "1.0.0",
  "description": "发货与装箱自动化本地控制台",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node web/server.js",
    "dev": "node --watch web/server.js",
    "setup": "npm --prefix shipping-auto install && npm --prefix packing-auto install",
    "test": "node --test web/server.test.js shared/browser-session.test.js",
    "test:browser": "node --test shared/browser-integration.test.js",
    "test:login": "node --test login-auto/login.test.js"
  }
}
