{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "发货控制台",
  "version": "1.0.0",
  "identifier": "com.koudouma.autoconsole",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5199",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "发货控制台",
        "label": "main",
        "width": 920,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
