{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口默认能力：事件监听（core）、opener 打开浏览器 / 打开业务目录、process 插件（零配置，无需 dialog 目录选择）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-url",
    "process:default"
  ]
}
